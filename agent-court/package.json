{
  "name": "agent-court",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs"
  },
  "dependencies": {
    "@cometchat/chat-sdk-javascript": "^4.2.0",
    "@cometchat/chat-uikit-react": "^7.2.3",
    "dompurify": "^3.4.16",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "vitest": "^4"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
